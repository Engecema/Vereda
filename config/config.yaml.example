server_url: https://engecema.com.br
listen_addr: 0.0.0.0:8080
metrics_listen_addr: 127.0.0.1:9090

private_key_path: /var/lib/vereda/private.key
noise:
  private_key_path: /var/lib/vereda/noise_private.key

prefixes:
  v4: 100.64.0.0/10
  v6: fd7a:115c:a1e0::/48

derp:
  server:
    enabled: false
  urls:
    - https://engecema.com.br/derpmap/default
  auto_update_enabled: true
  update_frequency: 24h

database:
  type: sqlite
  sqlite:
    path: /var/lib/vereda/db.sqlite

dns:
  magic_dns: true
  base_domain: engecema.internal
  nameservers:
    global:
      - 1.1.1.1
      - 9.9.9.9
